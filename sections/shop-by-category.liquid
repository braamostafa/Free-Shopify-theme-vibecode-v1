{% liquid
  assign title = section.settings.title
  assign section_width = section.settings.section_width
%}

<div class="shop-by-category section section--{{ section_width }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {% if title != blank %}
    <div class="shop-by-category__header">
      <h2 class="shop-by-category__title">{{ title }}</h2>
    </div>
  {% endif %}

  <div class="shop-by-category__grid">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign category_image = block.settings.custom_image | default: collection.featured_image | default: collection.image
          assign category_title = block.settings.title | default: collection.title | default: 'Category'
          assign category_url = collection.url | default: '#'
        %}

        <a href="{{ category_url }}" class="shop-by-category__item" {{ block.shopify_attributes }}>
          <div class="shop-by-category__image-wrapper">
            {% if category_image != blank %}
              {{
                category_image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  class: 'shop-by-category__image',
                  widths: '200, 400, 600',
                  sizes: '(min-width: 750px) 250px, 150px'
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'shop-by-category__image shop-by-category__image--placeholder' }}
            {% endif %}
          </div>
          <span class="shop-by-category__name">{{ category_title }}</span>
        </a>
      {% endfor %}
    {% else %}
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' or collection.handle == 'best-sellers' %}
          {% liquid
            assign category_image = collection.featured_image | default: collection.image
            assign category_title = collection.title
            assign category_url = collection.url
          %}

          <a href="{{ category_url }}" class="shop-by-category__item">
            <div class="shop-by-category__image-wrapper">
              {% if category_image != blank %}
                {{
                  category_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    class: 'shop-by-category__image',
                    widths: '200, 400, 600',
                    sizes: '(min-width: 750px) 250px, 150px'
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'shop-by-category__image shop-by-category__image--placeholder' }}
              {% endif %}
            </div>
            <span class="shop-by-category__name">{{ category_title }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .shop-by-category {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .shop-by-category__header {
    text-align: center;
    margin-bottom: var(--margin-xl, 32px);
  }

  .shop-by-category__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-foreground);
    margin: 0;
  }

  .shop-by-category__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  .shop-by-category__item {
    width: 180px;
  }

  @media screen and (max-width: 749px) {
    .shop-by-category__item {
      width: 140px;
    }
  }

  @media screen and (max-width: 449px) {
    .shop-by-category__item {
      width: 120px;
    }
  }

  .shop-by-category__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-foreground);
    background-color: #f5f5f5;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .shop-by-category__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .shop-by-category__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .shop-by-category__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .shop-by-category__item:hover .shop-by-category__image {
    transform: scale(1.06);
  }

  .shop-by-category__name {
    padding: 12px 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: #000;
    text-align: center;
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "shop-by-category-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "عنوان القسم (Section Title)",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "عرض القسم (Width)",
      "options": [
        {
          "value": "page-width",
          "label": "عرض الصفحة"
        },
        {
          "value": "full-width",
          "label": "عرض كامل"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "المسافة من الأعلى",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "المسافة من الأسفل",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "قسم / كوليكشن (Category)",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "اختر الكوليكشن (Collection)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "صورة مخصصة (اختياري)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "اسم مخصص (اختياري)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "category": "Collections",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
