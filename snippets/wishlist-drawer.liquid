{%- doc -%}
  A slide-in drawer that displays the user's wishlist products, persisted in
  localStorage. Opened from the mobile bottom nav and the desktop header.
{%- enddoc -%}

<wishlist-drawer id="wishlist-drawer" class="wishlist-drawer" role="dialog" aria-modal="true" aria-label="Wishlist">
  <div class="wishlist-drawer__overlay" data-wishlist-close></div>
  <div class="wishlist-drawer__panel">
    <div class="wishlist-drawer__header">
      <h2 class="wishlist-drawer__title">Wishlist</h2>
      <button class="wishlist-drawer__close button-unstyled" data-wishlist-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6L18 18"></path>
        </svg>
      </button>
    </div>
    <div class="wishlist-drawer__body" data-wishlist-body>
      <div class="wishlist-drawer__empty" data-wishlist-empty>
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <p>Your wishlist is empty</p>
      </div>
      <div class="wishlist-drawer__products" data-wishlist-products></div>
    </div>
  </div>
</wishlist-drawer>

<script>
  (function() {
    var DRAWER_ID = 'wishlist-drawer';

    function getDrawer() {
      return document.getElementById(DRAWER_ID);
    }

    function getWishlist() {
      try { return JSON.parse(localStorage.getItem('wishlist') || '[]'); }
      catch(e) { return []; }
    }

    function saveWishlist(list) {
      localStorage.setItem('wishlist', JSON.stringify(list));
    }

    function openDrawer() {
      var drawer = getDrawer();
      if (!drawer) return;
      renderProducts();
      drawer.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      var drawer = getDrawer();
      if (!drawer) return;
      drawer.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    function removeFromWishlist(productId) {
      var list = getWishlist().filter(function(item) { return item.id !== productId; });
      saveWishlist(list);
      document.querySelectorAll('[data-wishlist-toggle][data-product-id="' + productId + '"]').forEach(function(btn) {
        btn.removeAttribute('data-active');
      });
      renderProducts();
    }

    function updateBadges() {
      var count = getWishlist().length;
      document.querySelectorAll('[data-wishlist-count]').forEach(function(el) {
        el.textContent = count;
        if (count > 0) {
          el.removeAttribute('hidden');
        } else {
          el.setAttribute('hidden', '');
        }
      });
    }

    function renderProducts() {
      var drawer = getDrawer();
      if (!drawer) return;
      updateBadges();
      var items = getWishlist();
      var emptyEl = drawer.querySelector('[data-wishlist-empty]');
      var container = drawer.querySelector('[data-wishlist-products]');

      if (items.length === 0) {
        if (emptyEl) emptyEl.style.display = 'flex';
        if (container) container.innerHTML = '';
        return;
      }

      if (emptyEl) emptyEl.style.display = 'none';
      if (!container) return;

      var html = '';
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        html += '<div class="wishlist-drawer__item" data-product-id="' + item.id + '">'
          + '<a class="wishlist-drawer__item-image" href="/products/' + item.handle + '">'
          + '<img src="' + item.image + '" alt="' + item.title + '">'
          + '</a>'
          + '<div class="wishlist-drawer__item-info">'
          + '<a class="wishlist-drawer__item-title" href="/products/' + item.handle + '">' + item.title + '</a>'
          + '<span class="wishlist-drawer__item-price">' + item.price + '</span>'
          + '</div>'
          + '<button class="wishlist-drawer__item-remove button-unstyled" data-wishlist-remove="' + item.id + '" aria-label="Remove">'
          + '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6L18 18"></path></svg>'
          + '</button>'
          + '</div>';
      }
      container.innerHTML = html;

      container.querySelectorAll('[data-wishlist-remove]').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          removeFromWishlist(this.dataset.wishlistRemove);
        });
      });
    }

    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-wishlist-close]')) closeDrawer();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDrawer();
    });

    window.addEventListener('storage', function(e) {
      if (e.key === 'wishlist') {
        document.querySelectorAll('[data-wishlist-toggle]').forEach(function(btn) {
          var productId = btn.dataset.productId;
          var list = getWishlist();
          if (list.some(function(item) { return item.id === productId; })) {
            btn.setAttribute('data-active', '');
          } else {
            btn.removeAttribute('data-active');
          }
        });
        updateBadges();
        if (getDrawer() && getDrawer().classList.contains('is-open')) renderProducts();
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateBadges);
    } else {
      updateBadges();
    }

    window.wishlistDrawer = { open: openDrawer, close: closeDrawer, render: renderProducts, updateBadges: updateBadges };
  })();
</script>

{% stylesheet %}
  .wishlist-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
  }

  .wishlist-drawer.is-open {
    display: block;
  }

  .wishlist-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    animation: wishlist-fade-in 0.25s ease;
  }

  .wishlist-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 380px;
    max-width: 100vw;
    background: var(--color-background, #fff);
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
    animation: wishlist-slide-in 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media screen and (max-width: 749px) {
    .wishlist-drawer__panel {
      width: 100vw;
    }
  }

  .wishlist-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .wishlist-drawer__title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground, #000);
  }

  .wishlist-drawer__close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-foreground, #000);
    transition: background 0.2s;
  }

  .wishlist-drawer__close:hover {
    background: rgba(0, 0, 0, 0.06);
  }

  .wishlist-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
  }

  .wishlist-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 200px;
    color: var(--color-foreground, #999);
  }

  .wishlist-drawer__empty svg {
    opacity: 0.3;
  }

  .wishlist-drawer__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .wishlist-drawer__item-image {
    width: 64px;
    height: 64px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    background: #f5f5f5;
  }

  .wishlist-drawer__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wishlist-drawer__item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .wishlist-drawer__item-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-foreground, #000);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wishlist-drawer__item-price {
    font-size: 0.8125rem;
    color: var(--color-foreground, #666);
  }

  .wishlist-drawer__item-remove {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #999;
    flex-shrink: 0;
    transition: color 0.2s, background 0.2s;
  }

  .wishlist-drawer__item-remove:hover {
    color: #e74c3c;
    background: rgba(231, 76, 60, 0.08);
  }

  .wishlist-count-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding-inline: 4px;
    border-radius: 999px;
    background: #e74c3c;
    color: #fff;
    font-family: var(--font-paragraph--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    pointer-events: none;
  }

  .wishlist-count-badge[hidden] {
    display: none;
  }

  @keyframes wishlist-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes wishlist-slide-in {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
{% endstylesheet %}
