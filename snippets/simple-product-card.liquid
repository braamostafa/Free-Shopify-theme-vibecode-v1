{%- comment -%}
  Simple Product Card
  يعرض كارد المنتج ببساطة
  @param {object} product - المنتج
{%- endcomment -%}

<div class="simple-product-card">
  <a href="{{ product.url }}" class="simple-product-card__link">
    {% if product.featured_image %}
      <img 
        class="simple-product-card__image"
        src="{{ product.featured_image | image_url: width: 400 }}" 
        alt="{{ product.title | escape }}"
        loading="lazy"
        width="400"
        height="400"
      >
    {% else %}
      <div class="simple-product-card__placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
  </a>
  
  <div class="simple-product-card__content">
    <h3 class="simple-product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    
    <div class="simple-product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="simple-product-card__price--sale">{{ product.price | money }}</span>
        <span class="simple-product-card__price--compare">{{ product.compare_at_price | money }}</span>
      {% else %}
        <span class="simple-product-card__price--regular">{{ product.price | money }}</span>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .simple-product-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
  }
  
  .simple-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  
  .simple-product-card__link {
    display: block;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  
  .simple-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .simple-product-card:hover .simple-product-card__image {
    transform: scale(1.08);
  }
  
  .simple-product-card__placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .simple-product-card__placeholder svg {
    width: 80px;
    height: 80px;
    color: #ccc;
  }
  
  .simple-product-card__content {
    padding: 16px;
  }
  
  .simple-product-card__title {
    font-size: 15px;
    font-weight: 500;
    margin: 0 0 10px 0;
    line-height: 1.4;
  }
  
  .simple-product-card__title a {
    color: #333;
    text-decoration: none;
  }
  
  .simple-product-card__title a:hover {
    color: #000;
  }
  
  .simple-product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  .simple-product-card__price--regular {
    font-size: 16px;
    font-weight: 600;
    color: #333;
  }
  
  .simple-product-card__price--sale {
    font-size: 16px;
    font-weight: 600;
    color: #e74c3c;
  }
  
  .simple-product-card__price--compare {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
  }
</style>
