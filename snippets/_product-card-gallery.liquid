{%- endcomment -%}
{% if product == blank %}
  {% assign product = closest.product %}
{% endif %}
{% assign card_block_id = card_block_id | default: block.id %}
{% assign render_card_assets = render_card_assets | default: true %}

{% capture children %}
  {% unless product == blank %}
    {% if product.available %}
      {% assign first_variant = product.selected_or_first_available_variant %}
      {% if first_variant.compare_at_price > first_variant.price %}
        {% assign discount_pct = first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price | round %}
        <div class="product-discount-badge">
          -{{ discount_pct }}%
        </div>
      {% endif %}
    {% endif %}

    {%- if product.available == false or product.compare_at_price > product.price -%}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="
            --badge-border-radius: {{ settings.badge_corner_radius }}px;
            --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif product.compare_at_price > product.price -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    {% if product.available %}
      {% assign first_variant = product.selected_or_first_available_variant %}
      <div class="product-card-actions" data-variant-id="{{ first_variant.id }}" data-product-handle="{{ product.handle }}" data-options-count="{{ product.options.size }}" data-variants-count="{{ product.variants_count }}" data-product-title="{{ product.title | escape }}">
        <button type="button" class="product-card-actions__wishlist" data-wishlist-toggle aria-label="Add to Wishlist" data-product-id="{{ product.id }}">
          <svg class="product-card-actions__heart-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>
        <div class="product-card-actions__content">
          <button type="button" class="product-card-actions__add-btn" data-add-to-cart aria-label="Add to Cart">
            <svg class="product-card-actions__cart-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 6H22L20 16H8L6 6Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M6 6L5 2H2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="10" cy="20" r="2" stroke="currentColor" stroke-width="2"/>
              <circle cx="18" cy="20" r="2" stroke="currentColor" stroke-width="2"/>
            </svg>
            <svg class="product-card-actions__loading-icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="2" stroke-dasharray="35" stroke-dashoffset="10" fill="none"/>
            </svg>
            <span class="product-card-actions__add-text">Add to Cart</span>
          </button>
          <div class="product-card-actions__quantity">
            <button type="button" class="product-card-actions__qty-btn" data-qty-minus aria-label="Decrease quantity">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M3 7H11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <span class="product-card-actions__qty-value" data-qty-value>1</span>
            <button type="button" class="product-card-actions__qty-btn" data-qty-plus aria-label="Increase quantity">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 3V11M3 7H11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <dialog class="product-card-modal" id="product-modal-{{ card_block_id }}" scroll-lock>
        <div class="product-card-modal__wrapper">
          <div class="product-card-modal__content">
            <button class="button button-unstyled product-card-modal__close" style="background: #000000 !important; color: #ffffff !important; border: none !important; box-shadow: none !important;" aria-label="Close" data-modal-close>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6L18 18" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <div class="product-card-modal__scroll">
            <div class="product-card-modal__body">
            <div class="product-card-modal__gallery">
              <div class="product-card-modal__main-image">
                {% assign modal_first_image = product.images.first | default: product.featured_image %}
                <img src="{{ modal_first_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" data-modal-main-image data-image-id="{{ modal_first_image.id }}" data-image-index="0">
                {% if product.images.size > 1 %}
                  <button type="button" class="product-card-modal__arrow product-card-modal__arrow--prev" data-modal-prev aria-label="Previous image">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <button type="button" class="product-card-modal__arrow product-card-modal__arrow--next" data-modal-next aria-label="Next image">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <span class="product-card-modal__counter" data-modal-counter></span>
                {% endif %}
              </div>
              {% if product.images.size > 1 %}
                <div class="product-card-modal__thumbs">
                  {% for image in product.images limit:6 %}
                    <button type="button" class="product-card-modal__thumb{% if forloop.first %} is-active{% endif %}" data-modal-thumb data-src="{{ image | image_url: width: 800 }}" data-image-id="{{ image.id }}" data-image-index="{{ forloop.index0 }}">
                      <img src="{{ image | image_url: width: 100 }}" alt="{{ image.alt | escape }}" loading="lazy">
                    </button>
                  {% endfor %}
                </div>
              {% endif %}
            </div>

            <div class="product-card-modal__details">
              <h3 class="product-card-modal__title">{{ product.title }}</h3>

              <div class="product-card-modal__price" data-modal-price>
                {{ product.selected_or_first_available_variant.price | money }}
              </div>

              <div class="product-card-modal__options">
                {% for option in product.options_with_values %}
                  {% assign has_swatches = false %}
                  {% for value in option.values %}
                    {% if value.swatch != blank %}
                      {% assign has_swatches = true %}
                    {% endif %}
                  {% endfor %}
                  {% if has_swatches %}
                    <fieldset class="variant-option variant-option--swatches" data-option-index="{{ forloop.index0 }}">
                      <legend>{{ option.name }}</legend>
                      <div class="product-card-modal__swatches-list">
                        {% for value in option.values %}
                          <label class="variant-option__button-label variant-option__button-label--has-swatch">
                            <input
                              type="radio"
                              name="{{ option.name }}-modal-{{ card_block_id }}"
                              value="{{ value | escape }}"
                              data-option-name="{{ option.name }}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              data-option-available="{{ value.available }}"
                              aria-label="{{ value.name | escape }}{% if value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                              {% if value.selected %}checked{% endif %}
                              {% if value.available == false %}disabled aria-disabled="true"{% endif %}
                            >
                            {% render 'swatch', swatch: value.swatch, mode: 'unscaled', label: value.name %}
                            {% render 'strikethrough-variant', product_option: value %}
                          </label>
                        {% endfor %}
                      </div>
                      <span class="variant-option__swatch-value">{{ option.selected_value }}</span>
                    </fieldset>
                  {% else %}
                    <fieldset class="variant-option variant-option--buttons" data-option-index="{{ forloop.index0 }}">
                      <legend>{{ option.name }}</legend>
                      <div class="product-card-modal__buttons-list">
                        {% for value in option.values %}
                          <label class="variant-option__button-label">
                            <input
                              type="radio"
                              name="{{ option.name }}-modal-{{ card_block_id }}"
                              value="{{ value | escape }}"
                              data-option-name="{{ option.name }}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              data-option-available="{{ value.available }}"
                              aria-label="{{ value.name | escape }}{% if value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                              {% if value.selected %}checked{% endif %}
                              {% if value.available == false %}disabled aria-disabled="true"{% endif %}
                            >
                            <span class="variant-option__button-label__pill"></span>
                            <span class="variant-option__button-label__text">{{ value }}</span>
                            {% render 'strikethrough-variant', product_option: value %}
                          </label>
                        {% endfor %}
                      </div>
                    </fieldset>
                  {% endif %}
                {% endfor %}
              </div>

              <div class="product-card-modal__buy-group">
                <div class="product-card-modal__row-top">
                  <div class="product-card-modal__quantity">
                    <button type="button" class="product-card-modal__qty-btn" data-modal-qty-minus aria-label="Decrease quantity">
                      <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
                        <path d="M3 7H11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <input type="number" min="1" value="1" class="product-card-modal__qty-input" data-modal-qty-input aria-label="Quantity">
                    <span class="product-card-modal__qty-value" data-modal-qty-value style="display:none;">1</span>
                    <button type="button" class="product-card-modal__qty-btn" data-modal-qty-plus aria-label="Increase quantity">
                      <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
                        <path d="M7 3V11M3 7H11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </div>
                  <button type="button" class="button product-card-modal__add-btn" data-modal-add-to-cart>
                    <svg class="product-card-modal__cart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 6H22L20 16H8L6 6Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M6 6L5 2H2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <circle cx="10" cy="20" r="2" fill="none" stroke="currentColor" stroke-width="2"/>
                      <circle cx="18" cy="20" r="2" fill="none" stroke="currentColor" stroke-width="2"/>
                    </svg>
                    <span class="product-card-modal__spinner" style="display:none;"></span>
                    <span data-modal-add-text>Add to Cart</span>
                  </button>
                </div>
                <div class="product-card-modal__row-bottom">
                  {% assign modal_form_id = 'ProductModalForm-' | append: card_block_id %}
                  {% form 'product', product, id: modal_form_id, data-type: 'add-to-cart-form' %}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-modal-form-variant-id>
                    <input type="hidden" name="quantity" value="1" data-modal-form-quantity>
                    <div class="product-card-modal__express-checkout">
                      <button type="button" class="button button-secondary product-card-modal__buy-btn" data-modal-buy-now>Buy Now</button>
                    </div>
                  {% endform %}
                </div>
              </div>

              <a href="{{ product.url }}" class="product-card-modal__view-details">View full details</a>
            </div>
            </div>
          </div>
        </div>
        <script type="application/json" data-modal-variants>
          {{ product.variants | json }}
        </script>
      </dialog>
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children, force_square: true, product: product, block: block %}

<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% if render_card_assets %}
{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}
{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}

<style>
  .product-discount-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    display: var(--product-discount-badge-display, block);
    background: var(--product-discount-badge-bg, #fde9e4);
    color: var(--product-discount-badge-color, #dc2626);
    font-size: var(--product-discount-badge-font-size, 0.75rem);
    font-weight: 700;
    padding: 4px 8px;
    border-radius: var(--product-discount-badge-radius, 4px);
    pointer-events: none;
  }

  .product-card-actions {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  .product-card-actions__content {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%) translateY(40px);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: auto;
  }

  @media screen and (min-width: 750px) {
    product-card:is(:hover, :focus-within) .product-card-actions__content {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  @media screen and (max-width: 749px) {
    .product-card-actions__content {
      opacity: 1;
      bottom: 48px;
    }
  }

  .product-card-actions__quantity {
    display: none !important;
  }

  .product-card-actions__add-text {
    display: none;
  }

  .product-card-actions__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    width: 42px;
    height: 42px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 0;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: #000;
    transition: all 0.3s ease;
  }

  .product-card-actions__add-btn:hover {
    background: rgba(255, 255, 255, 1);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    transform: translateY(-1px);
  }

  .product-card-actions__add-btn svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  .product-card-actions__loading-icon {
    display: none;
    animation: spin 1s linear infinite;
  }

  .product-card-actions__add-btn.is-loading .product-card-actions__cart-icon {
    display: none;
  }

  .product-card-actions__add-btn.is-loading .product-card-actions__loading-icon {
    display: block;
  }

  /* Wishlist heart button */
  .product-card-actions__wishlist {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 11;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    padding: 0;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.25s ease, transform 0.25s ease, background 0.2s ease;
    pointer-events: auto;
  }

  .product-card-actions__wishlist svg {
    width: 18px;
    height: 18px;
    transition: fill 0.2s ease, stroke 0.2s ease;
  }

  .product-card-actions__wishlist:hover {
    background: rgba(255, 255, 255, 1);
    transform: scale(1.1);
  }

  .product-card-actions__wishlist[data-active] {
    opacity: 1;
    transform: scale(1);
  }

  .product-card-actions__wishlist[data-active] svg {
    fill: #e74c3c;
    stroke: #e74c3c;
  }

  @media screen and (min-width: 750px) {
    product-card:is(:hover, :focus-within) .product-card-actions__wishlist {
      opacity: 1;
      transform: scale(1);
    }

    product-card:is(:hover, :focus-within) .product-card-actions__wishlist:hover {
      transform: scale(1.1);
    }
  }

  @media screen and (max-width: 749px) {
    .product-card-actions__wishlist {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Modal Styles */
  .product-card-modal {
    border: none;
    padding: 0;
    background: transparent;
    overflow: visible;
    max-height: 100dvh;
    -webkit-tap-highlight-color: transparent;
  }

  .product-card-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  /* Wrapper that provides the gap from viewport edges and centers the dialog */
  .product-card-modal::before {
    content: '';
    display: none; /* Not needed â€” dialog handles its own layout */
  }

  .product-card-modal__wrapper {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    pointer-events: none;
    -webkit-tap-highlight-color: transparent;
    will-change: transform, opacity;
  }

  .product-card-modal__content {
    position: relative;
    background: var(--color-background, #fff);
    border-radius: 12px;
    width: 100%;
    max-width: 940px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    flex-shrink: 0;
    pointer-events: auto;
  }

  .product-card-modal__scroll {
    max-height: 84dvh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .product-card-modal__close {
    position: absolute;
    top: -18px;
    right: -18px;
    z-index: 10;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000000 !important;
    color: #ffffff !important;
    border-radius: 0;
    cursor: pointer;
    border: none !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.35) !important;
    outline: none !important;
    transition: all 0.2s ease;
  }

  .product-card-modal__close svg {
    color: #ffffff;
    stroke: #ffffff;
    fill: none;
  }

  .product-card-modal__close:hover {
    background: #000000 !important;
    color: #ffffff !important;
    transform: scale(1.05);
  }

  .product-card-modal__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .product-card-modal__gallery {
    padding: 20px;
    border-right: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product-card-modal__main-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    background: #fafafa;
  }

  .product-card-modal__main-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }

  .product-card-modal__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    cursor: pointer;
    color: var(--color-foreground, #000);
    z-index: 2;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .product-card-modal__arrow:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.08);
  }

  .product-card-modal__arrow--prev {
    left: 10px;
  }

  .product-card-modal__arrow--next {
    right: 10px;
  }

  .product-card-modal__counter {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.75rem;
    line-height: 1;
    padding: 4px 10px;
    border-radius: 999px;
    z-index: 2;
    pointer-events: none;
  }

  .product-card-modal__thumbs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .product-card-modal__thumb {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid transparent;
    padding: 0;
    background: transparent;
    transition: border-color 0.2s ease;
  }

  .product-card-modal__thumb.is-active {
    border-color: var(--color-foreground, #000);
  }

  .product-card-modal__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card-modal__details {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product-card-modal__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-foreground, #000);
  }

  .product-card-modal__price {
