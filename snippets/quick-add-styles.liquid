{%- doc -%}
  Quick-add styles consolidated into a single snippet.

  @example
  {% render 'quick-add-styles' %}
{%- enddoc -%}

{% style %}
  .custom-color-quick-add {
    --quick-add-background: {{ settings.quick_add_background }};
    --quick-add-foreground: {{ settings.quick_add_text }};
  }
{% endstyle %}

{% stylesheet %}
  /* Quick Add */
  .quick-add {
    position: absolute;
    inset: 0;
    z-index: var(--layer-raised);
    pointer-events: none;
  }

  .quick-add .variant-option__button-label input[data-option-available='false'] {
    cursor: not-allowed;
  }

  [data-quick-add-button='choose'] add-to-cart-component {
    display: none;
  }

  [data-quick-add-button='add'] .quick-add__button--choose {
    display: none;
  }

  product-card:is(:hover, :focus-within) .quick-add__button {
    opacity: 1;
    transform: translateY(0);
  }

  button.quick-add__button {
    --quick-add-collapsed-width: 42px;
    --quick-add-icon-width: 20px;
    --quick-add-expanded-width: max-content;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.1);
    height: var(--quick-add-collapsed-width);
    width: var(--quick-add-collapsed-width);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    overflow: hidden;
    color: var(--quick-add-foreground, var(--color-foreground));
    pointer-events: all;
    position: absolute;
    left: 12px;
    bottom: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media screen and (max-width: 749px) {
    button.quick-add__button {
      opacity: 1;
      transform: translateY(0);
      border-radius: 50%;
      width: 42px;
      height: 42px;
    }
  }

  @media screen and (min-width: 750px) {
    button.quick-add__button:hover {
      width: auto;
      padding: 0 16px 0 12px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.95);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
      transform: translateY(0) scale(1.02);
    }
  }

  .quick-add__button.add-to-cart-button {
    height: 42px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .quick-add__button .svg-wrapper .checkmark-burst {
    width: 20px;
    height: 20px;
  }

  .quick-add__button > .add-to-cart-icon {
    flex-shrink: 0;
    width: var(--quick-add-icon-width);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quick-add__button > .add-to-cart-icon svg {
    width: 20px;
    height: 20px;
  }

  .quick-add__product-form-component {
    height: 100%;
  }

  .quick-add__product-form-component .shopify-product-form {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    height: 100%;
  }

  .quick-add-modal .product-media {
    width: 100%;
    height: 100%;
  }

  .quick-add-modal deferred-media {
    display: none;
  }

  .quick-add-modal .media-gallery--carousel slideshow-component {
    --cursor: default;
  }

  .quick-add__button[data-added='true'] {
    width: 42px;
    padding: 0;
    border-radius: 50%;
  }

  .quick-add__button[data-added='true'] > *:not(.add-to-cart__added) {
    opacity: 0;
  }

  .quick-add__button[data-added='true'] .add-to-cart__added {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--quick-add-foreground, var(--color-foreground));
  }

  @media (prefers-reduced-motion: no-preference) {
    button.quick-add__button {
      transition-property: all;
      transition-duration: 0.3s;
      transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
  }
{% endstylesheet %}
